<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studenttracker.fx.controller.dialog.ApplyDialogController"
      spacing="6" prefWidth="460" styleClass="dialog-form">
    <Label fx:id="opportunityLabel" styleClass="dialog-context" wrapText="true"/>
    <Label text="Applied on *" styleClass="field-label"/>
    <DatePicker fx:id="appliedOnPicker" maxWidth="Infinity"/>
    <Label text="Notes" styleClass="field-label"/>
    <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" promptText="Where you applied, who referred you (optional)"/>
</VBox>
