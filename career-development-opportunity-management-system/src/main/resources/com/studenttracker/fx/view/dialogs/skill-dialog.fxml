<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studenttracker.fx.controller.dialog.SkillDialogController"
      spacing="6" prefWidth="460" styleClass="dialog-form">
    <Label text="Skill *" styleClass="field-label"/>
    <ComboBox fx:id="nameCombo" editable="true" maxWidth="Infinity" promptText="Pick one or type a new skill"/>
    <Label text="Proficiency *" styleClass="field-label"/>
    <ComboBox fx:id="proficiencyCombo" maxWidth="Infinity"/>
    <Label text="Status *" styleClass="field-label"/>
    <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
    <Label text="Notes" styleClass="field-label"/>
    <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" promptText="Topics to practise (optional)"/>
</VBox>
