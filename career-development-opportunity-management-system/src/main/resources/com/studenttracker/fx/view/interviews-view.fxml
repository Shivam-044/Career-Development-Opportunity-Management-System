<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studenttracker.fx.controller.InterviewsFxController"
      styleClass="page" spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <HBox styleClass="segmented" alignment="CENTER_LEFT">
            <fx:define>
                <ToggleGroup fx:id="scopeGroup"/>
            </fx:define>
            <ToggleButton text="Upcoming" userData="UPCOMING" toggleGroup="$scopeGroup" selected="true" styleClass="segment"/>
            <ToggleButton text="Past" userData="PAST" toggleGroup="$scopeGroup" styleClass="segment"/>
            <ToggleButton text="All" userData="ALL" toggleGroup="$scopeGroup" styleClass="segment"/>
        </HBox>
        <Label text="Highlighted rows are still to come" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="deleteButton" text="Delete" styleClass="btn, btn-danger, hover-lift" onAction="#deleteInterview">
            <graphic><Region styleClass="icon, icon-delete"/></graphic>
        </Button>
        <Button fx:id="editButton" text="Edit" styleClass="btn, btn-secondary, hover-lift" onAction="#editInterview">
            <graphic><Region styleClass="icon, icon-edit"/></graphic>
        </Button>
        <Button fx:id="addButton" text="Add interview" styleClass="btn, btn-primary, hover-lift" onAction="#addInterview">
            <graphic><Region styleClass="icon, icon-add"/></graphic>
        </Button>
    </HBox>
    <VBox styleClass="glass-card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
