<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studenttracker.fx.controller.CompaniesFxController"
      styleClass="page" spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <CheckBox fx:id="showArchived" text="Show archived" onAction="#reload"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="websiteButton" text="Open website" styleClass="btn, btn-secondary, hover-lift" onAction="#openWebsite">
            <graphic><Region styleClass="icon, icon-open"/></graphic>
        </Button>
        <Button fx:id="archiveButton" text="Archive" styleClass="btn, btn-secondary, hover-lift" onAction="#toggleArchived">
            <graphic><Region styleClass="icon, icon-archive"/></graphic>
        </Button>
        <Button fx:id="editButton" text="Edit" styleClass="btn, btn-secondary, hover-lift" onAction="#editCompany">
            <graphic><Region styleClass="icon, icon-edit"/></graphic>
        </Button>
        <Button fx:id="addButton" text="Add company" styleClass="btn, btn-primary, hover-lift" onAction="#addCompany">
            <graphic><Region styleClass="icon, icon-add"/></graphic>
        </Button>
    </HBox>
    <VBox styleClass="glass-card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
