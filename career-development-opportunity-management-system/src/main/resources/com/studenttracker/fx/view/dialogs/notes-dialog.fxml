<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studenttracker.fx.controller.dialog.NotesDialogController"
      spacing="6" prefWidth="480" styleClass="dialog-form">
    <Label fx:id="subjectLabel" styleClass="dialog-context" wrapText="true"/>
    <Label text="Notes" styleClass="field-label"/>
    <TextArea fx:id="notesArea" prefRowCount="7" wrapText="true"/>
</VBox>
